<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADA_Schema" version="1.4.1">
  <asset>
    <contributor/>
    <created>2026-10-10T00:00:00</created>
    <modified>2026-10-10T00:00:00</modified>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_geometries>
    <geometry id="geom-1" name="geom-1">
      <mesh>
        <source id="geom-1-positions">
          <float_array id="geom-1-positions-array" count="9">0 0 0 1 0 0 0 1 0</float_array>
          <technique_common>
            <accessor source="#geom-1-positions-array" count="3" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geom-1-vertices">
          <input semantic="POSITION" source="#geom-1-positions"/>
        </vertices>
        <triangles count="1">
          <input semantic="VERTEX" source="#geom-1-vertices" offset="0"/>
          <p>0 1 2</p>
        </triangles>
      </mesh>
    </geometry>
    <geometry id="geom-2" name="geom-2">
      <mesh>
        <source id="geom-2-positions">
          <float_array id="geom-2-positions-array" count="9">1 1 0 2 1 0 1 2 0</float_array>
          <technique_common>
            <accessor source="#geom-2-positions-array" count="3" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="geom-2-vertices">
          <input semantic="POSITION" source="#geom-2-positions"/>
        </vertices>
        <triangles count="1">
          <input semantic="VERTEX" source="#geom-2-vertices" offset="0"/>
          <p>0 1 2</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="MultiMeshNode" name="MultiMeshNode">
