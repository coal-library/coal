cc_library(
    name = "coal",
    srcs = COAL_SOURCES + select({
        ":octomap_enabled": ["src/octree.cpp"],
        "//conditions:default": [],
    }),
    hdrs = COAL_PUBLIC_HEADERS + select({
        ":hpp_fcl_compatibility_enabled": HPP_FCL_COMPATIBILITY_HEADERS,
        "//conditions:default": [],
    }),
    copts = select({
        "@platforms//os:windows": ["/bigobj"],
        "//conditions:default": [],
    }),
    # These mirror the CMake build's `target_compile_definitions(coal PUBLIC
    # ...)` calls: they leak into the public headers (e.g. COAL_USE_FLOAT_PRECISION
    # selects the `Scalar` typedef in coal/data_types.h), so downstream
    # consumers of this target must see them too.
    defines = select({
        "@platforms//os:windows": ["NOMINMAX"],
        "//conditions:default": [],
    }) + select({
        ":logging_enabled": ["COAL_ENABLE_LOGGING", "BOOST_LOG_DYN_LINK"],
        "//conditions:default": [],
    }) + select({
        ":float_precision_enabled": ["COAL_USE_FLOAT_PRECISION"],
        "//conditions:default": [],
    }) + select({
        ":assert_into_exception_enabled": ["COAL_TURN_ASSERT_INTO_EXCEPTION"],
        "//conditions:default": [],
    }) + select({
        ":hpp_fcl_compatibility_enabled": ["COAL_BACKWARD_COMPATIBILITY_WITH_HPP_FCL"],
        "//conditions:default": [],
    }) + select({
        ":octomap_enabled": [
            "COAL_HAS_OCTOMAP",
            "COAL_HAVE_OCTOMAP",
        ],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkstatic = True,
    # COAL_HAS_QHULL only gates a private .cpp implementation detail (see
    # src/shape/geometric_shapes.cpp), so it stays private, matching the
    # CMake build's `target_compile_definitions(coal PRIVATE COAL_HAS_QHULL)`.
    local_defines = ["coal_EXPORTS"] + select({
        ":qhull_enabled": ["COAL_HAS_QHULL"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@assimp",
        "@boost.asio",
        "@boost.core",
        "@boost.filesystem",
        "@boost.iostreams",
        "@boost.math",
        "@boost.serialization",
        "@eigen",
    ] + select({
        ":logging_enabled": ["@boost.log"],
        "//conditions:default": [],
    }) + select({
        ":qhull_enabled": [
            "@qhull//:qhull_r",
            "@qhull//:qhullcpp",
        ],
        "//conditions:default": [],
    }) + select({
        ":octomap_enabled": ["@octomap"],
        "//conditions:default": [],
    }),
)

# Alias kept for parity with the CMake build's `hpp-fcl`/`hpp-fcl::hpp-fcl`
# targets (only meaningful once COAL_BACKWARD_COMPATIBILITY_WITH_HPP_FCL is
# turned on, but harmless as a plain alias otherwise).
alias(
    name = "hpp-fcl",
    actual = ":coal",
    visibility = ["//visibility:public"],
)
