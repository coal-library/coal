load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # BSD-3-Clause

# ---------------------------------------------------------------------------
# Build options
#
# These mirror the `option()`/`cmake_dependent_option()` declarations in the
# top-level CMakeLists.txt / src/CMakeLists.txt. All of them default to OFF,
# matching the upstream CMake defaults (octomap and qhull are opt-in there
# too: octomap via auto-detection of an installed package, qhull via an
# explicit option defaulting to FALSE).
#
# COAL_BUILD_WITH_TRACY is kept only for interface parity with the CMake
# build: Tracy is not wired up to any dependency here, so flipping it on
# will fail to build. eigenpy/python bindings are not ported at all (no
# flag is exposed for them).
# ---------------------------------------------------------------------------

bool_flag(
    name = "COAL_ENABLE_LOGGING",
    build_setting_default = False,
)

bool_flag(
    name = "COAL_BACKWARD_COMPATIBILITY_WITH_HPP_FCL",
    build_setting_default = False,
)

bool_flag(
    name = "COAL_USE_FLOAT_PRECISION",
    build_setting_default = False,
)

bool_flag(
    name = "COAL_TURN_ASSERT_INTO_EXCEPTION",
    build_setting_default = False,
)

bool_flag(
    name = "COAL_BUILD_WITH_TRACY",
    build_setting_default = False,
)

bool_flag(
    name = "COAL_HAS_QHULL",
    build_setting_default = False,
)

bool_flag(
    name = "COAL_HAS_OCTOMAP",
    build_setting_default = False,
)

config_setting(
    name = "logging_enabled",
    flag_values = {":COAL_ENABLE_LOGGING": "True"},
)

config_setting(
    name = "hpp_fcl_compatibility_enabled",
    flag_values = {":COAL_BACKWARD_COMPATIBILITY_WITH_HPP_FCL": "True"},
)

config_setting(
    name = "float_precision_enabled",
    flag_values = {":COAL_USE_FLOAT_PRECISION": "True"},
)

config_setting(
    name = "assert_into_exception_enabled",
    flag_values = {":COAL_TURN_ASSERT_INTO_EXCEPTION": "True"},
)

config_setting(
    name = "tracy_enabled",
    flag_values = {":COAL_BUILD_WITH_TRACY": "True"},
)

config_setting(
    name = "qhull_enabled",
    flag_values = {":COAL_HAS_QHULL": "True"},
)

config_setting(
    name = "octomap_enabled",
    flag_values = {":COAL_HAS_OCTOMAP": "True"},
)

# ---------------------------------------------------------------------------
# Generated headers
#
# These correspond to the config.hh/deprecated.hh/warning.hh headers that
# jrl-cmakemodules' GENERATE_CONFIGURATION_HEADER()/header.cmake macros
# produce at configure time (see cmake/{config,deprecated,warning}.hh.cmake
# and cmake/header.cmake). PACKAGE_CPPNAME for project "coal" is "COAL",
# HEADER_DIR is "coal", and EXPORT_SYMBOL is "coal_EXPORTS".
# ---------------------------------------------------------------------------

expand_template(
    name = "gen_config_hh",
    out = "include/coal/config.hh",
    substitutions = {
        "@LIBRARY_NAME@": "COAL",
        "@PROJECT_VERSION@": "3.0.4",
        "@PROJECT_VERSION_MAJOR_CONFIG@": "3",
        "@PROJECT_VERSION_MINOR_CONFIG@": "0",
        "@PROJECT_VERSION_PATCH_CONFIG@": "4",
        "@EXPORT_SYMBOL@": "coal_EXPORTS",
    },
    template = "cmake/config.hh.cmake",
)

expand_template(
    name = "gen_deprecated_hh",
    out = "include/coal/deprecated.hh",
    substitutions = {
        "@PACKAGE_CPPNAME@": "COAL",
    },
    template = "cmake/deprecated.hh.cmake",
)

expand_template(
    name = "gen_tracy_hh",
    out = "include/coal/tracy.hh",
    substitutions = select({
        ":tracy_enabled": {
            "@LIBRARY_NAME@": "COAL",
            "@DEFINE_TRACY_ENABLE@": "#define COAL_TRACY_ENABLE",
        },
        "//conditions:default": {
            "@LIBRARY_NAME@": "COAL",
            "@DEFINE_TRACY_ENABLE@": "",
        },
    }),
    template = "cmake/tracy.hh.cmake",
)

expand_template(
    name = "gen_warning_hh",
    out = "include/coal/warning.hh",
    substitutions = {
        "@PACKAGE_CPPNAME@": "COAL",
    },
    template = "cmake/warning.hh.cmake",
)

# ---------------------------------------------------------------------------
# coal core library
# ---------------------------------------------------------------------------

COAL_PUBLIC_HEADERS = glob(
    [
        "include/coal/**/*.h",
        "include/coal/**/*.hh",
        "include/coal/**/*.hxx",
    ],
    exclude = [
        "include/coal/third_party/**",
    ],
) + [
    ":gen_config_hh",
    ":gen_deprecated_hh",
    ":gen_tracy_hh",
    ":gen_warning_hh",
]

HPP_FCL_COMPATIBILITY_HEADERS = glob([
    "include/hpp/**/*.h",
    "include/hpp/**/*.hh",
    "include/hpp/**/*.hxx",
    "include/hpp/**/*.hpp",
])

COAL_SOURCES = [
